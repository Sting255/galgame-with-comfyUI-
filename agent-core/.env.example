# ============================================
#  此文件仅供参考，列出所有可用的环境变量。
#  .env 文件由系统自动创建和管理，
#  所有配置通过 Settings 网页修改即可。
# ============================================

# ── LLM（Settings > LLM API）──
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# ── 基础设施 ──
PORT=3099
DB_PATH=./data/agent.db
VECTOR_SERVICE_URL=http://localhost:8765
COMFYUI_URL=http://localhost:8188
COMFYUI_OUTPUT_DIR=./output

# ── 数据库维护（2026-10-01 补：这两个键由上游 v3.6.2 带入，缺省即生效，原先没有任何文档）──
# DB_AUTO_VACUUM：启动时若空闲页占比 ≥25% 且库文件 ≥100MB，就在监听端口前同步 VACUUM。
#   本机小库（<100MB）永不触发；换大库时启动会静默多等几分钟。写 0 关闭。
# DB_AUTO_VACUUM=0
#
# IMAGE_TASK_TEXT_RETENTION_DAYS：生图任务历史「瘦身」——把 N 天前 image_tasks 行的
#   prompt_original / prompt_refined / workflow_template 清空（图片文件和行都保留）。
#   ⚠️ 这段提示词文本**不可再生**：HiresFix「细化」要反查它才能复用原提示词，
#   而立绘 / 头像 / 小镇素材 / 表情包 / 群相册那批**没有兜底**，清了就只能拿到空提示词。
#   上游缺省 30 天；**本仓已改成缺省不删**，只有显式写正整数天才瘦身。
#   想恢复上游行为：IMAGE_TASK_TEXT_RETENTION_DAYS=30；彻底关闭：0
# IMAGE_TASK_TEXT_RETENTION_DAYS=0

# ── 天气 ──
WEATHER_CITY=

# 发布版建议：LOG_TO_FILE=false（不落盘日志；排障时改 true）
# LOG_TO_FILE=false
